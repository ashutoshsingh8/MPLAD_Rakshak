# ============================================================
# MPLAD Rakshak — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- MySQL Database ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mplad_rakshak
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_URL=mysql+pymysql://user:password@mysql:3306/mplad_rakshak

# --- Qdrant Vector Database ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Supabase Cloud Storage (Optional) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=inspection-photos

# --- Application Paths ---
DATA_DIR=./data
UPLOAD_DIR=./uploads

# --- JWT Auth (Mock) ---
JWT_SECRET_KEY=mplad-rakshak-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- data.gov.in (optional) ---
DATA_GOV_IN_API_KEY=
